{
  "expo": {
    "name": "Ajuda Pet",
    "slug": "ajuda-pet",
    "owner": "jose.ccna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7A52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ajudapet.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ajudapet",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#17120F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ajuda Pet usa suas fotos para mostrar o rosto do seu pet.",
          "cameraPermission": "O Ajuda Pet usa a câmera para tirar a foto do seu pet."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C2410C"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9d8f178-45e4-4f9c-b64a-2b50212bc2a4"
      }
    }
  }
}
